<odoo>
<menuitem id="menu_root" name="Uae Einvoice Lab" groups="uae_einvoice_lab.group_user"/>
<record id="view_providers_list" model="ir.ui.view"><field name="name">ue.provider.list</field><field name="model">ue.provider</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="mode"/><field name="sandbox_url"/><field name="token_env"/><field name="customization"/><field name="profile"/><field name="transaction_code"/><field name="invoice_xsd"/><field name="credit_xsd"/><field name="rule_files"/><field name="strict_validation"/><field name="simulator_result"/><field name="max_attempts"/></list></field></record>
<record id="view_providers_form" model="ir.ui.view"><field name="name">ue.provider.form</field><field name="model">ue.provider</field><field name="arch" type="xml"><form><header></header><sheet><group><field name="name"/><field name="company_id"/><field name="mode"/><field name="sandbox_url"/><field name="token_env"/><field name="customization"/><field name="profile"/><field name="transaction_code"/><field name="invoice_xsd"/><field name="credit_xsd"/><field name="rule_files"/><field name="strict_validation"/><field name="simulator_result"/><field name="max_attempts"/></group></sheet></form></field></record>
<record id="action_providers" model="ir.actions.act_window"><field name="name">ASP Laboratory Settings</field><field name="res_model">ue.provider</field><field name="view_mode">list,form</field></record><menuitem id="menu_providers" name="ASP Laboratory Settings" parent="menu_root" action="action_providers"/>
<record id="view_documents_list" model="ir.ui.view"><field name="name">ue.document.list</field><field name="model">ue.document</field><field name="arch" type="xml"><list><field name="move_id"/><field name="company_id"/><field name="provider_id"/><field name="revision"/><field name="uuid"/><field name="state"/><field name="validation_level"/><field name="validation_messages"/><field name="provider_state"/><field name="submission_id"/><field name="attempts"/><field name="next_retry"/><field name="filename"/><field name="payload_hash"/></list></field></record>
<record id="view_documents_form" model="ir.ui.view"><field name="name">ue.document.form</field><field name="model">ue.document</field><field name="arch" type="xml"><form><header><button type="object" name="action_validate" string="Build and Validate"/><button type="object" name="action_submit" string="Submit Snapshot"/><button type="object" name="action_poll" string="Poll Sandbox"/><button type="object" name="action_new_revision" string="Create Corrected Revision"/></header><sheet><group><field name="move_id"/><field name="company_id"/><field name="provider_id"/><field name="revision"/><field name="uuid"/><field name="state"/><field name="validation_level"/><field name="validation_messages"/><field name="provider_state"/><field name="submission_id"/><field name="attempts"/><field name="next_retry"/><field name="filename"/><field name="payload_hash"/></group><field name="xml_file" filename="filename"/><field name="transmission_ids"/></sheet></form></field></record>
<record id="action_documents" model="ir.actions.act_window"><field name="name">Structured Invoice Documents</field><field name="res_model">ue.document</field><field name="view_mode">list,form</field></record><menuitem id="menu_documents" name="Structured Invoice Documents" parent="menu_root" action="action_documents"/>
</odoo>
